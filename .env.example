# SQLite is the default for local runs. Docker Compose supplies PostgreSQL.
FINLEDGER_ENV=development
AUTH_REQUIRED=true
AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_ALLOW_SIGNUP=true
UPLOAD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
DATABASE_URL=sqlite:///./finledger.db
AUTO_CREATE_DB=true
MAX_UPLOAD_MB=15
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_BUSINESS_ID=demo-business
WHATSAPP_GRAPH_API_VERSION=v22.0
DEMO_MODE=true
DEFAULT_CURRENCY=INR
NEXT_PUBLIC_API_URL=http://localhost:8000
